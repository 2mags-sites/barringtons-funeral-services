# BEGIN reviews subdomain goes to the main site (ctl01, 6 Nov 2026)
# This host exists only for WordPress and Get Great Reviews at /news. The rest of this folder
# is the old site, which Google was indexing as a duplicate.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^reviews\.barringtonsfunerals\.co\.uk$ [NC]
RewriteCond %{QUERY_STRING} (^|&)slug=([^&]+)
RewriteRule ^blog-post(\.php)?$ https://barringtonsfunerals.co.uk/news/%2? [R=301,L]
RewriteCond %{HTTP_HOST} ^reviews\.barringtonsfunerals\.co\.uk$ [NC]
RewriteRule ^(index(-new)?(\.php)?)?$ https://barringtonsfunerals.co.uk/? [R=301,L]
RewriteCond %{HTTP_HOST} ^reviews\.barringtonsfunerals\.co\.uk$ [NC]
RewriteRule ^blog-news(\.php)?$ https://barringtonsfunerals.co.uk/news? [R=301,L]
RewriteCond %{HTTP_HOST} ^reviews\.barringtonsfunerals\.co\.uk$ [NC]
RewriteRule ^contact(\.php|/)?$ https://barringtonsfunerals.co.uk/#contact? [R=301,NE,L]
RewriteCond %{HTTP_HOST} ^reviews\.barringtonsfunerals\.co\.uk$ [NC]
RewriteRule ^pet-products(\.php|/)?$ https://barringtonsfunerals.co.uk/services? [R=301,L]
RewriteCond %{HTTP_HOST} ^reviews\.barringtonsfunerals\.co\.uk$ [NC]
RewriteCond %{REQUEST_URI} !^/(news|assets|\.well-known)(/|$)
RewriteRule ^(.*?)(\.php)?$ https://barringtonsfunerals.co.uk/$1 [R=301,L]
</IfModule>
# END reviews subdomain goes to the main site

# BEGIN 2mags-probe-block
# Managed by 2mags-new-server/tools/probe-block.sh - do not edit by hand.
<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.php$ - [F,L]

RewriteRule (^|/)\.(env|git|svn|aws|ssh|htpasswd)(/|$) - [F,L]

RewriteRule \.(sql|bak|old|swp|ini|log)$ - [F,L]

RewriteRule \.wpress$ - [F,L]
RewriteRule (^|/)wp-content/ai1wm-backups/ - [F,L]

RewriteRule (^|/)wp-config\.php[^/]+$ - [F,L]
RewriteRule (^|/)wp-config\.[^/]*\.php$ - [F,L]
RewriteRule (^|/)wp-config\.(bak|old|save|orig|txt|inc|bkp|prostack)$ - [F,L]

RewriteRule \.(bak|old|save|orig)[.\-_][^/]*$ - [F,L]

RewriteCond %{REQUEST_URI} \.php[^/]+$
RewriteCond %{REQUEST_URI} !\.(jpe?g|png|gif|webp|avif|svg|ico|css|js|map|json|pdf|zip|mp4|webm|woff2?|ttf|eot)$ [NC]
RewriteRule .* - [F,L]

RewriteRule ^(webmin|adminer|phpmyadmin|pma)(/|$) - [F,L]

RewriteRule (^|/)dup-installer(-cache)?(/|$) - [F,L]
RewriteRule (^|/)duplicator/installer(/|$) - [F,L]
RewriteRule (^|/)(main\.installer|installer-backup)\.php$ - [F,L]

RewriteRule (^|/)wp-content/uploads/gravity_forms/ - [F,L]

RewriteRule (^|/)xmlrpc\.php$ - [F,L]
RewriteRule (^|/)wp-comments-post\.php$ - [F,L]
</IfModule>
# END 2mags-probe-block







# BEGIN Brandy Digital - deny site archives / DB dumps (2026-07-26)
# Full-site zips in a docroot contain wp-config.php (DB credentials + salts).
# converted from <FilesMatch \.(sql|tar|tgz|gz|bz2|7z|rar|sql\.gz)$> by htaccess_convert.py
RewriteRule \.(sql|tar|tgz|gz|bz2|7z|rar|sql\.gz)$ - [F,L]
<IfModule mod_rewrite.c>
	RewriteEngine On
	# .zip anywhere except wp-content/uploads/
	RewriteCond %{REQUEST_URI} !^/wp-content/uploads/ [NC]
	RewriteCond %{REQUEST_URI} \.zip$ [NC]
	RewriteRule .* - [F,L]
</IfModule>
# END Brandy Digital - deny site archives / DB dumps
# BEGIN Brandy Digital - deny dev/editor backup files (2026-07-25)
# .old/.bak/.orig are not parsed as PHP and would be served as plaintext source.
# converted from <FilesMatch \.(old|bak|orig|save|swp|swo|rej)$> by htaccess_convert.py
RewriteRule \.(old|bak|orig|save|swp|swo|rej)$ - [F,L]
# converted from <FilesMatch ~$> by htaccess_convert.py
RewriteRule ~$ - [F,L]
# END Brandy Digital - deny dev/editor backup files
# Barringtons Funeral Services - Production .htaccess
# Rename this file to .htaccess when deploying to production

# ============================================
# SECURITY - PROTECT SENSITIVE FILES (CRITICAL)
# ============================================

# Block access to .env files (MOST IMPORTANT)
# converted from <Files .env> by htaccess_convert.py
RewriteRule (^|/)\.env$ - [F,L]

# Block all dot files
# converted from <FilesMatch ^\.> by htaccess_convert.py
RewriteRule (^|/)\. - [F,L]

# Protect sensitive file extensions
# converted from <FilesMatch \.(env|json|log|md|gitignore|lock|yml|yaml|ini|conf|config)$> by htaccess_convert.py
RewriteRule \.(env|json|log|md|gitignore|lock|yml|yaml|ini|conf|config)$ - [F,L]

# Protect includes directory
RewriteEngine On

# Allow JavaScript files from includes directory (needed for admin mode)
RewriteCond %{REQUEST_URI} ^/includes/.*\.js$ [NC]
RewriteRule ^ - [L]

# Block access to includes, content, cache, vendor directories (except JS files above)
RewriteRule ^(includes|content|cache|vendor)/ - [F,L]

# ============================================
# PHP CONFIGURATION
# ============================================

# Set PHP version (adjust if needed for your host)
# AddHandler application/x-httpd-php74 .php

# PHP Settings for better security
<IfModule mod_php7.c>
</IfModule>

# ============================================
# PERFORMANCE & CACHING
# ============================================

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
    ExpiresActive On

    # Images
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"

    # Others
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/x-font-woff "access plus 1 month"
    ExpiresByType application/x-font-woff2 "access plus 1 month"
    ExpiresByType font/woff "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# ============================================
# URL REWRITING & CLEAN URLS
# ============================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (uncomment in production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Force www (choose one: with or without www)
    # With www:
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

    # Without www:
    # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

    # Redirect /index to homepage
    RewriteCond %{THE_REQUEST} /index(?:\.php)?\s [NC]
    RewriteRule ^index(?:\.php)?$ / [R=301,L]

    # Remove .php extension (clean URLs)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]

    # Redirect .php to clean URL (but not for POST requests)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} /([^.]+)\.php [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Remove trailing slash
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)/$ /$1 [R=301,L]

    # ============================================
    # HEADLESS WORDPRESS BLOG REDIRECTS
    # ============================================

    # Redirect old WordPress media URLs to new /news/ location
    # Pattern: /wp-content/uploads/... -> /news/wp-content/uploads/...
    RewriteRule ^wp-content/uploads/(.*)$ /news/wp-content/uploads/$1 [R=301,L]

    # Redirect old WordPress date-based URLs to new headless structure
    # Pattern: /YYYY/MM/post-slug/ -> /blog-post.php?slug=post-slug
    RewriteRule ^[0-9]{4}/[0-9]{2}/([^/]+)/?$ /blog-post.php?slug=$1 [R=301,L]

    # Redirect direct WordPress post URLs from /news to headless structure
    # Pattern: /news/post-slug/ -> /blog-post.php?slug=post-slug
    RewriteRule ^news/([^/]+)/?$ /blog-post.php?slug=$1 [R=301,L]

    # Prevent access to WordPress feed URLs (use our own if needed)
    RewriteRule ^news/feed/?$ /blog-news.php [R=301,L]

    # Error pages
    ErrorDocument 404 /404.php
    ErrorDocument 403 /403.php
    ErrorDocument 500 /500.php
</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================

<IfModule mod_headers.c>
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"

    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "same-origin"

    # Block /news from search engines (headless WordPress - admin only)
    <If "%{REQUEST_URI} =~ m#^/news#">
        Header set X-Robots-Tag "noindex, nofollow"
    </If>

    # Content Security Policy (adjust as needed)
    # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.muchloved.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src https://www.youtube.com;"
</IfModule>

# ============================================
# DIRECTORY BROWSING & OPTIONS
# ============================================

# Disable directory browsing
Options -Indexes

# Disable server signature
ServerSignature Off

# ============================================
# UPLOAD DIRECTORY SECURITY
# ============================================

<Directory "/assets/images/uploads">
    # Disable PHP execution in uploads
# converted from <FilesMatch \.ph(p[2-7]?|tml)$> by htaccess_convert.py
RewriteRule \.ph(p[2-7]?|tml)$ - [F,L]

    # Only allow image files
    <FilesMatch "^.*\.(gif|jpe?g|png|webp|svg)$">
        Order allow,deny
        Allow from all
    </FilesMatch>
</Directory>

# ============================================
# WORDPRESS BLOG PROTECTION
# ============================================

# Protect WordPress files if blog is installed
<IfModule mod_rewrite.c>
    RewriteRule ^blog/wp-admin/install\.php$ - [F]
    RewriteRule ^blog/wp-admin/includes/ - [F]
    RewriteRule ^blog/wp-includes/theme-compat/ - [F]
</IfModule>

# ============================================
# RATE LIMITING & ANTI-SPAM
# ============================================

# Block suspicious user agents
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} ^.*(bot|crawl|spider).*$ [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
    RewriteCond %{HTTP_USER_AGENT} ^.*(wget|curl).*$ [NC]
    # Allow legitimate bots (Google, Bing, etc)
    RewriteCond %{HTTP_USER_AGENT} !^.*(google|bing|yandex|baidu).*$ [NC]
    RewriteRule ^contact-handler\.php$ - [F,L]
</IfModule>

# ============================================
# CUSTOM MIME TYPES
# ============================================

<IfModule mod_mime.c>
    AddType application/font-woff .woff
    AddType application/font-woff2 .woff2
    AddType application/vnd.ms-fontobject .eot
    AddType application/x-font-ttf .ttf
    AddType font/opentype .otf
    AddType image/svg+xml .svg
    AddType image/webp .webp
</IfModule>

# ============================================
# NOTES FOR PRODUCTION DEPLOYMENT
# ============================================

# 1. Rename this file from .htaccess.production to .htaccess
# 2. Update error_log path on line 38 to your actual path
# 3. Uncomment HTTPS redirect lines 84-85 after SSL is configured
# 4. Choose www or non-www redirect (lines 88-94) and uncomment
# 5. Adjust Content-Security-Policy header if needed (line 125)
# 6. Test thoroughly after deployment

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php80” package as the default “PHP” programming language.
<IfModule mime_module>
</IfModule>
# php -- END cPanel-generated handler, do not edit
